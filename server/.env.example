NODE_ENV=development
PORT=5200
SITE_URL=https://musicidl.web.id
TRUST_PROXY_HOPS=1

# Binary lokal/VPS. Nama command akan dicari dari PATH.
PYTHON_BIN=python3
YT_DLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg
DENO_BIN=deno
# Kosongkan untuk memakai engine default. Path relatif dihitung dari folder server.
ENGINE_SCRIPT_PATH=

# Kosongkan untuk koneksi langsung. Contoh WARP: socks5://127.0.0.1:40000
DOWNLOAD_PROXY=
ALLOW_REMOTE_COMPONENTS=false

# Batas resource
ENGINE_TIMEOUT_MS=600000
INFO_TIMEOUT_MS=30000
MAX_ACTIVE_DOWNLOADS=2
MAX_QUEUED_DOWNLOADS=8
JOB_TTL_MS=3600000
HEALTHCHECK_BINARIES=true
MAX_DURATION_SECONDS=900
MAX_SOURCE_BYTES=104857600

# Storefront untuk pencocokan artwork/metadata iTunes.
ITUNES_COUNTRY=ID
